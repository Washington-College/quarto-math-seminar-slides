{
  "name": "Washington College Math Seminar (Quarto)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "latest",
      "installTinyTex": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto"
      ],
      "settings": {
        "quarto.render.browser": "internal",
        "quarto.render.previewType": "editor"
      }
    }
  },
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Quarto Preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "echo '=== Codespace Ready! Run: quarto preview index.qmd ==='"
}

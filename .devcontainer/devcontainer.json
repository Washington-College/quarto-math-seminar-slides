{
  "name": "Washington College Math Seminar (Quarto)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "latest",
      "installTinyTex": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "James-Yu.latex-workshop",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "quarto.render.browser": "internal",
        "quarto.render.previewType": "editor"
      }
    }
  },
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Quarto Preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "echo '=== Washington College Math Seminar Codespace Ready! Run: quarto preview index.qmd ==='"
}
